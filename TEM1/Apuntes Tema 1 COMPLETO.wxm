/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
inverso_mod_aux(u,v):= if v[1] > u[1] then inverso_mod_aux(v,u)
    else if v[1]=0 then "No existe"
    else if v[1]=1 then v[2]
    else inverso_mod_aux(v,u-quotient(u[1],v[1])*v)$
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
trace(inverso_mod_aux);
